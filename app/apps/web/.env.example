# JoinOrigin web — environment variables
#
# Copy to `.env.local` (local dev) or supply to Docker:
#   docker compose up --build   # reads the same names from your shell or .env
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time.
# In Docker they are passed as build args (see docker-compose.yml) — changing
# them requires a rebuild (`docker compose build`). All are optional; the app
# runs with the documented defaults below.

# ── Site ────────────────────────────────────────────────────────────────────
# Public origin used for SEO metadata / canonical URLs / OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Domain reported to analytics + site metadata.
NEXT_PUBLIC_SITE_DOMAIN=joinorigin.com

# ── Analytics (optional) ────────────────────────────────────────────────────
# Plausible is enabled by default (self-hosted). Point it at your analytics
# host when not using the default. Umami + GA4 are opt-in via their IDs.
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://analytics.joinorigin.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Full override — replaces the tracker list entirely with a JSON config:
#   NEXT_PUBLIC_ANALYTICS_JSON={"trackers":[{"id":"plausible","kind":"plausible","domain":"joinorigin.com"}],"trackPageViews":true}

# ── Server (runtime, Docker) ────────────────────────────────────────────────
# Port + bind host inside the container (set by docker-compose/Dockerfile).
PORT=3100
HOSTNAME=0.0.0.0
# Where the waitlist API appends CSV rows (default: data/leads.csv).
LEADS_CSV_PATH=/app/apps/web/data/leads.csv
