# JoinOrigin web — environment variables
#
# Copy to `.env.local` (local dev) or supply to Docker:
#   docker compose up --build   # reads the same names from your shell or .env
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time.
# In Docker they are passed as build args (see docker-compose.yml) — changing
# them requires a rebuild (`docker compose build`). All are optional; the app
# runs with the documented defaults below.

# ── Site ────────────────────────────────────────────────────────────────────
# Public origin used for SEO metadata / canonical URLs / OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Domain reported to analytics + site metadata.
NEXT_PUBLIC_SITE_DOMAIN=joinorigin.com

# ── Analytics (optional) ────────────────────────────────────────────────────
# Plausible is enabled by default (self-hosted). The Docker compose stack at
# the monorepo root ships a local Plausible instance (http://localhost:8000 by
# default, see the PLAUSIBLE_* variables below), so the API host defaults to
# that local endpoint. Umami + GA4 are opt-in via their IDs.
NEXT_PUBLIC_PLAUSIBLE_API_HOST=http://localhost:8000
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Full override — replaces the tracker list entirely with a JSON config.
# Point it at the local self-hosted Plausible:
#   NEXT_PUBLIC_ANALYTICS_JSON={"trackers":[{"id":"plausible","kind":"plausible","domain":"joinorigin.com","apiHost":"http://localhost:8000"}],"trackPageViews":true}

# ── Local analytics stack (Docker compose) ──────────────────────────────────
# These configure the self-hosted Plausible services in docker-compose.yml
# (plausible / plausible_db / plausible_events_db). Create a root `.env` next
# to docker-compose.yml and re-run `docker compose up -d` after changing them.
# Host port the Plausible dashboard/API is exposed on (default 8000). If you
# change this, also set NEXT_PUBLIC_PLAUSIBLE_API_HOST to http://localhost:<port>.
PLAUSIBLE_PORT=8000
# Origin Plausible uses for links/CSWSH checks — keep http://localhost:<port> locally.
PLAUSIBLE_BASE_URL=http://localhost:8000
# Required by Plausible (>= 64 bytes). The compose file has a dev-only default;
# generate a real one for anything non-local: openssl rand -base64 48
PLAUSIBLE_SECRET_KEY_BASE=
# Registration policy: false = open (default, create the first user at
# http://localhost:8000/register), true = closed, invite_only = invites only.
PLAUSIBLE_DISABLE_REGISTRATION=false
# Password for the analytics Postgres (compose default: postgres).
PLAUSIBLE_DB_PASSWORD=postgres

# ── Server (runtime, Docker) ────────────────────────────────────────────────
# Port + bind host inside the container (set by docker-compose/Dockerfile).
PORT=3100
HOSTNAME=0.0.0.0
# Where the waitlist API appends CSV rows (default: data/leads.csv).
LEADS_CSV_PATH=/app/apps/web/data/leads.csv
